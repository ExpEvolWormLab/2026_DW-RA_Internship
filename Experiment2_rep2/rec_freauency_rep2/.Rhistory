competitions <- c("V5", "V6", "V7", "V8")
# function
fit_predict_one_comp <- function(comp, df) {
# V6 uses the V8 calibration curve
calib_comp <- ifelse(comp == "V6", "V8", comp)
# Calibration data used to fit the model
calib_df <- df %>%
dplyr::filter(
calib == "calib",
competition == calib_comp
) %>%
dplyr::mutate(
ratio = as.numeric(stringr::str_remove(ratio, "%")) / 100
) %>%
dplyr::filter(
!is.na(ratio),
!is.na(normEBS.decrease)
)
# Check whether calibration data are available
if (nrow(calib_df) == 0) {
stop(
paste0(
"No valid calibration data found for competition ",
calib_comp,
"."
)
)
}
# Fit calibration model
model <- mgcv::gam(
ratio ~ s(normEBS.decrease, df = 4),
data = calib_df
)
# Values used to draw the fitted calibration curve
curve_x <- seq(0, 1, 0.01)
pgam <- data.frame(
xx = curve_x,
yy = as.numeric(
predict(
model,
newdata = data.frame(normEBS.decrease = curve_x)
)
)
)
# Make the calibration plot
plot_title <- if (comp == "V6") {
"V6 calibration curve (using V8 calibration)"
} else {
paste0(comp, " calibration curve")
}
p <- ggplot2::ggplot() +
ggplot2::geom_point(
data = calib_df,
ggplot2::aes(
x = normEBS.decrease,
y = ratio,
color = ratio
),
shape = 1,
size = 3,
stroke = 1
) +
ggplot2::geom_line(
data = pgam,
ggplot2::aes(x = xx, y = yy),
linewidth = 1
) +
ggplot2::labs(
x = "EBS-normalized mutant melting signal",
y = "Known rec-1 mutant frequency",
title = plot_title
) +
ggplot2::theme_bw() +
ggplot2::theme(
axis.title = ggplot2::element_text(
size = 17,
colour = "black",
face = "bold"
),
axis.text = ggplot2::element_text(
size = 15,
colour = "black"
),
strip.text = ggplot2::element_text(
size = 15,
colour = "black",
face = "bold"
),
plot.title = ggplot2::element_text(
size = 17,
hjust = -0.1,
face = "bold"
),
legend.position = "none"
)
# Predict the samples from the requested competition
# For V6, this uses the model fitted with V8 calibration data
pred_df <- df %>%
dplyr::filter(competition == comp) %>%
dplyr::mutate(
calibration_used = calib_comp,
predicted_freq = as.numeric(
predict(model, newdata = .)
)
)
list(
competition = comp,
calibration_used = calib_comp,
calib = calib_df,
model = model,
prediction = pred_df,
curve = pgam,
plot = p
)
}
# loop
results <- setNames(
map(competitions, fit_predict_one_comp, df = meltinfo),
competitions
)
calib_df <- df %>% filter(calib == "calib",competition == calib_comp) %>%
mutate( ratio = as.numeric(str_remove(ratio, "%")) / 100) %>%
filter(!is.na(ratio),!is.na(normEBS.decrease))
# function
fit_predict_one_comp <-function(comp, df) {
calib_comp <- ifelse(comp == "V6", "V8", comp)
calib_df <- df %>% filter(calib == "calib",competition == calib_comp) %>%
mutate( ratio = as.numeric(str_remove(ratio, "%")) / 100) %>%
filter(!is.na(ratio),!is.na(normEBS.decrease))
model <- gam(ratio ~ s(normEBS.decrease, df = 4),data = calib_df)
# If you want to plot the model
pgam =data.frame(xx=seq(0.0,1,0.01),
yy=predict(model, newdata = data.frame(normEBS.decrease=seq(0,1,0.01))) )
p <- ggplot()+
geom_point(data=calib_df,
aes(normEBS.decrease, ratio, color = ratio), shape=1, size=3,stroke=1)+
#theme_Publication2()+
xlab("EBS-normalized mutant melting signal")+ylab("known rec-1 mutant frequency")+
ggtitle(paste0(comp, "calibration curve"))+
theme(axis.title = element_text(size=17,colour = "black", face = "bold"),
axis.text = element_text(size=15, colour = "black"),
strip.text = element_text(size = 15, color = "black", face = "bold"),
plot.title = element_text(size = 17, hjust = -0.1, face = "bold"),
legend.position = "none")+
geom_line(data=pgam, aes(x=xx, y=yy),size=1)+
theme_bw()
pred_df <- df %>%
filter(competition == comp)%>%
mutate(predicted_freq = as.numeric(predict(model, newdata=.)))
list(competition =comp,
calib = calib_df,
model = model,
prediction = pred_df,
curve = pgam,
plot = p)
}
# loop
results <- setNames(
map(competitions, fit_predict_one_comp, df = meltinfo),
competitions
)
summary(results$V5$model)
summary(results$V6$model)
summary(results$V7$model)
summary(results$V8$model)
results$V5$plot
results$V6$plot
results$V7$plot
results$V8$plot
results$V5$plot
results$V6$plot
results$V7$plot
results$V8$plot
predicted_all <- map_dfr(results, "prediction")
write.table(
predicted_all,
file = "predicted_frequencies_block2.csv",
sep = ";",
row.names = FALSE,
quote = FALSE
)
View(predicted_all)
